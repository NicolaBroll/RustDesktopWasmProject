// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Rust",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/rust:2-1-bookworm",

	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {},
		"ghcr.io/devcontainers/features/node:2.1.1": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/github-cli:1.1.3": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
	},

	// Claude Code keeps everything (credentials, .claude.json, settings, history) in this dir,
	// which is backed by a named volume so authentication survives container rebuilds.
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},

	"mounts": [
		{
			"source": "claude-code-config-${devcontainerId}",
			"target": "/home/vscode/.claude",
			"type": "volume"
		},
		{
			"source": "devcontainer-cargo-cache-${devcontainerId}",
			"target": "/usr/local/cargo",
			"type": "volume"
		}
	],

	// Fix volume ownership (new volumes are created as root), install Chrome and the tools for the headless desktop app.
	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				// Rust
				"rust-lang.rust-analyzer",
				"vadimcn.vscode-lldb",
				"tamasfe.even-better-toml",
				"fill-labs.dependi",
				"usernamehw.errorlens",
				// Claude Code
				"anthropic.claude-code"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
