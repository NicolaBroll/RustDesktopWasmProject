# Comparing two revisions in the details panel (compare.rs, view/compare_view.rs).

compare-title = Compare { $from } with { $to }
compare-swap = Swap
compare-swap-hint = Exchange the two sides: show the changes the other way round
compare-back = Back to the commit
compare-back-hint = Close the comparison and show the selected commit (Esc)
compare-from = From
compare-to = To
compare-base = Merge base
compare-brings = What { $to } brings since it diverged from { $from }: its changes against the merge base.
compare-plain = The changes from the first commit to the second.
compare-loading = Comparing…
compare-retry = Retry
compare-with-selected = Compare with the selected commit
compare-with-selected-hint = Show the changes between { $selected } and { $id } (also Ctrl+click on the row)
compare-with-current = Compare with { $current } (what it brings)
compare-with-current-hint = Show what { $name } brings since it diverged from { $current }
