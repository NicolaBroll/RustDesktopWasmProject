engine-lines-patch-delete-leftover = the deletion would leave some content
engine-lines-patch-no-newline = line without a newline followed by another line
engine-lines-patch-no-tail-context = hunk without trailing context at line { $start }, not at the end of the file
engine-lines-patch-mismatch = different content at line { $line }
engine-lines-patch-no-head-context = hunk without leading context at line { $start }, not at the start of the file
engine-lines-patch-misplaced = misplaced hunk at line { $start }
engine-lines-patch-hunk-zero = hunk at line 0
engine-lines-patch-not-in-index = the file does not exist in the index
engine-lines-patch-added-exists = new file, but it already exists
engine-lines-no-tail-context = the hunk at line { $line } has no trailing context and does not reach the end of the file
engine-lines-no-head-context = the hunk at line { $line } has no leading context and does not start at the beginning of the file
engine-lines-not-anchored = the patch for `{ $path }` cannot be anchored safely: { $reason }; stage or unstage the whole file
engine-lines-none-selected = no lines chosen: `lines` is empty
engine-lines-diff-changed = the diff changed since it was read
engine-lines-type-change = `{ $path }` has several changes on the same path (a type change, for example from file to link): lines cannot be chosen, stage or unstage the whole file
engine-lines-no-unstaged = the file no longer has unstaged changes
engine-lines-no-staged = the file no longer has staged changes
engine-lines-patch-failed = the patch does not apply to the staged version of `{ $target }` ({ $error }): nothing written, reload the diff
engine-lines-index-changed = the index changed while the write was being prepared (another git process?): nothing written, try again
engine-lines-index-unexpected = after the write, the index entry of `{ $target }` is not the expected one (another git process?)
engine-lines-index-unexpected-backup = after the write, the index entry of `{ $target }` is not the expected one (another git process?); the previous staged version is in `{ $backup }`
engine-lines-head-invalid = HEAD does not point to a valid commit (nor to a branch without commits): nothing unstaged
