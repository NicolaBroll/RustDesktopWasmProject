# Changed file text and relative dates (format.rs).

format-change-added = added
format-change-deleted = deleted
format-change-modified = modified
format-change-type-changed = type changed
format-change-renamed = renamed
format-change-copied = copied
format-change-unmerged = unmerged
format-change-untracked = untracked
format-change-ignored = ignored
format-change-unmodified = unmodified
format-relative-now = just now
format-relative-minutes = { $n } min ago
format-relative-hours = { $n } h ago
format-relative-days = { $n ->
    [one] yesterday
   *[other] { $n } days ago
}
format-relative-months = { $n ->
    [one] 1 month ago
   *[other] { $n } months ago
}
format-relative-years = { $n ->
    [one] 1 year ago
   *[other] { $n } years ago
}
