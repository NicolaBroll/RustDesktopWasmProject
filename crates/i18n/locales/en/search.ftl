# Search in the history (search.rs, view/commits.rs).

search-hint = Search messages, authors, ids (Ctrl+F)
search-searching = Searching…
search-no-matches = No matches
search-position = { $n } of { $total }
search-count = { $total ->
    [one] 1 match
   *[other] { $total } matches
}
search-failed = Search failed
search-previous = Previous match (Shift+Enter)
search-next = Next match (Enter)
search-close = Close the search (Esc)
search-hint-content = Text added or removed by the commits, Enter to search (slow)
search-content = Content
search-content-tip = Search what the commits changed instead of messages, authors and ids (slower: press Enter to search)
search-regex = Regex
search-regex-tip = The text is a regular expression (POSIX extended) matched against the added and removed lines
search-ignore-case-tip = Ignore upper and lower case
search-press-enter = Press Enter to search
search-stop = Stop
search-stop-tip = Stop the search in the content
search-stopped = Stopped
search-found = { $count } found
search-found-more = { $count }+ found
search-position-more = { $n } of { $total }+
