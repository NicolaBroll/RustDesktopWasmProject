# Undo and Redo (discard.rs, UndoOp).

undo-undo = Undo
undo-redo = Redo
undo-undo-hint = Undo: { $next }
undo-redo-hint = Redo: { $next }
undo-nothing-to-undo = Nothing to undo
undo-nothing-to-redo = Nothing to redo
undo-undone = Undone: { $description }
undo-redone = Redone: { $description }
undo-done = Done
undo-backups = ; backup in { $refs }
undo-warning = ; warning: { $warning }
