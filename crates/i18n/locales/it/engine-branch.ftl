engine-branch-delete-current = `{ $name }` è il branch attivo (HEAD), niente eliminato
engine-branch-no-local = non esiste un branch locale `{ $name }`, niente modificato
engine-branch-not-local = `{ $full }` non è un branch locale
engine-branch-checkout-conflicts = ci sono file in conflitto ({ $files }): risolverli prima di cambiare branch, niente modificato
engine-branch-missing = non esiste un branch `{ $full }`, niente modificato
engine-branch-changed = `{ $full }` è cambiato: doveva essere { $expected }, ora è { $now }; niente modificato
engine-branch-name-taken = il nome `{ $full }` è già preso da `{ $name }`, niente modificato (un ref non si sovrascrive)
engine-branch-not-in-upstream = né in HEAD né nell'upstream `{ $upstream }`
engine-branch-not-in-head = in HEAD
engine-branch-same-name = `new_name` è uguale a `name`
engine-branch-unmerged = il branch `{ $name }` non è unito: { $unmerged } commit (fino a { $tip }) non sono { $reference }. Eliminandolo resterebbero solo nel backup `refs/project/backup/delete-...` salvato prima, e `edit.undo` lo ricreerebbe
engine-branch-moved = il branch `{ $name }` si è spostato da quando è stato visto: era { $seen }, ora punta a { $target }. Niente eliminato; rileggere i branch e riprovare
engine-branch-delete-active = `{ $name }` è il branch attivo (HEAD), niente eliminato: passare prima a un altro branch
engine-branch-expected-hex = `expected` deve essere l'id completo ({ $len } cifre esadecimali) del commit del branch: `{ $value }`
engine-branch-unborn-start = HEAD non ha ancora commit: indicare `start`, o creare prima un commit
engine-branch-exists = esiste già un branch `{ $name }`, niente modificato (un branch non si sovrascrive)
engine-branch-delete-other-worktree = `{ $name }` è il branch attivo del worktree `{ $worktree }`, niente eliminato
engine-branch-assume-unchanged = file segnati `--assume-unchanged` diversi nel branch di destinazione ({ $files }): git ne sovrascriverebbe le modifiche senza controllarle. Niente modificato; togliere il segno (`git update-index --no-assume-unchanged`) e riprovare
engine-branch-name-taken-git = il nome `{ $name }` è già preso, niente modificato (un ref non si sovrascrive): { $stderr }
engine-branch-git-rejects-name = git non accetta `{ $name }` come nome di branch
engine-branch-checkout-head-moved = dopo il checkout HEAD è { $head } invece di { $target }: un hook `post-checkout` o un altro processo l'ha cambiata; controllare HEAD prima di continuare
engine-branch-checkout-head-unreadable = dopo il checkout HEAD non si rilegge ({ $error })
engine-branch-config-not-removed-delete = branch eliminato, ma la configurazione `branch.{ $name }.*` non si è tolta: { $error }
engine-branch-rename-moved = dopo la rinomina `{ $new }` vale { $now } invece di { $expected }: un altro processo ha spostato il branch durante l'operazione
engine-branch-config-not-utf8 = il valore di `{ $key }` non è UTF-8: non salvato, `edit.undo` non lo rimetterà
engine-branch-config-unreadable = la configurazione `branch.{ $name }.*` non si legge ({ $error }): non toccata
engine-branch-config-changed = la configurazione `branch.{ $name }.*` è cambiata dopo l'undo: lasciata com'è
engine-branch-config-not-removed = la configurazione `branch.{ $name }.*` non si è tolta: { $error }
engine-branch-config-exists-saved = esiste già una configurazione `branch.{ $name }.*`: quella salvata con l'eliminazione non è stata riscritta ({ $entries })
engine-branch-config-exists = esiste già una configurazione `branch.{ $name }.*`: quella salvata non è stata riscritta
engine-branch-memory-no-upstream = configurazione `branch.{ $name }.*` senza upstream: non riscritta nel repo in memoria
engine-branch-config-partly = la configurazione `branch.{ $name }.*` è stata riscritta solo in parte: { $error } (valori salvati: { $entries })
engine-branch-config-not-written = configurazione non riscritta: { $error }
engine-branch-track-no-start = `track` richiede `start`: il branch remoto da seguire (es. `origin/main`)
engine-branch-track-ambiguous = `{ $start }` è anche `{ $other }`, che git prenderebbe per primo: indica il branch remoto per intero (`refs/remotes/{ $start }`)
engine-branch-track-rolled-back = non è stato possibile scrivere l'upstream di `{ $name }` ({ $error }): il branch appena creato è stato eliminato di nuovo, nulla è cambiato
engine-branch-track-not-rolled-back = non è stato possibile scrivere l'upstream di `{ $name }` ({ $error }) né eliminare di nuovo il branch appena creato ({ $rollback }): il branch esiste senza upstream
