engine-lines-patch-delete-leftover = l'eliminazione lascerebbe del contenuto
engine-lines-patch-no-newline = riga senza a capo seguita da un'altra riga
engine-lines-patch-no-tail-context = hunk senza contesto in coda alla riga { $start }, non alla fine del file
engine-lines-patch-mismatch = contenuto diverso alla riga { $line }
engine-lines-patch-no-head-context = hunk senza contesto in testa alla riga { $start }, non all'inizio del file
engine-lines-patch-misplaced = hunk fuori posto alla riga { $start }
engine-lines-patch-hunk-zero = hunk alla riga 0
engine-lines-patch-not-in-index = il file non esiste nell'indice
engine-lines-patch-added-exists = file nuovo, ma esiste già
engine-lines-no-tail-context = l'hunk alla riga { $line } non ha contesto in coda e non arriva alla fine del file
engine-lines-no-head-context = l'hunk alla riga { $line } non ha contesto in testa e non parte dall'inizio del file
engine-lines-not-anchored = la patch per `{ $path }` non si può ancorare con sicurezza: { $reason }; si mette in stage o si toglie dallo stage il file intero
engine-lines-none-selected = nessuna riga scelta: `lines` è vuoto
engine-lines-diff-changed = il diff è cambiato da quando è stato letto
engine-lines-type-change = `{ $path }` ha più modifiche sullo stesso percorso (cambio di tipo, ad esempio da file a link): le righe non si possono scegliere, si mette in stage o si toglie dallo stage il file intero
engine-lines-no-unstaged = il file non ha più modifiche non in stage
engine-lines-no-staged = il file non ha più modifiche in stage
engine-lines-patch-failed = la patch non si applica alla versione in stage di `{ $target }` ({ $error }): niente scritto, rileggere il diff
engine-lines-index-changed = l'indice è cambiato mentre si preparava la scrittura (un altro processo git?): niente scritto, riprovare
engine-lines-index-unexpected = dopo la scrittura la voce di `{ $target }` nell'indice non è quella attesa (un altro processo git?)
engine-lines-index-unexpected-backup = dopo la scrittura la voce di `{ $target }` nell'indice non è quella attesa (un altro processo git?); la versione in stage precedente è in `{ $backup }`
engine-lines-head-invalid = HEAD non punta a un commit valido (né a un branch senza commit): niente tolto dallo stage
engine-lines-lfs = `{ $path }` è salvato in Git LFS: il diff mostra il suo puntatore, le cui righe non si possono scegliere una per una; aggiungi, togli o scarta il file intero
