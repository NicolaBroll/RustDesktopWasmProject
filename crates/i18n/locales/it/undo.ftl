# Annulla e Ripeti (discard.rs, UndoOp).

undo-undo = Annulla
undo-redo = Ripeti
undo-undo-hint = Annulla: { $next }
undo-redo-hint = Ripeti: { $next }
undo-nothing-to-undo = Niente da annullare
undo-nothing-to-redo = Niente da ripetere
undo-undone = Annullato: { $description }
undo-redone = Rifatto: { $description }
undo-done = Fatto
undo-backups = ; backup in { $refs }
undo-warning = ; attenzione: { $warning }
